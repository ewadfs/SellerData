{
  "manifest_version": 3,
  "name": "SellerData - Amazon Seller Central Messaging Assistant",
  "version": "2.0.0",
  "description": "AI-powered customer messaging assistant for Amazon Seller Central with guided refund and replacement workflows.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://sellercentral.amazon.com/*",
    "https://sellercentral.amazon.co.uk/*",
    "https://sellercentral.amazon.de/*",
    "https://sellercentral.amazon.co.jp/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://sellercentral.amazon.com/*",
        "https://sellercentral.amazon.co.uk/*",
        "https://sellercentral.amazon.de/*",
        "https://sellercentral.amazon.co.jp/*"
      ],
      "js": ["lib/utils.js", "content.js", "shipment-page.js", "deals-page.js", "home-page.js", "asdn-page.js", "inventory-page.js"],
      "css": ["content.css", "shipment-page.css", "deals-page.css", "home-page.css", "asdn-page.css", "inventory-page.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
