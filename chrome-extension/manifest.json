{
  "manifest_version": 3,
  "name": "SellerData - Amazon Seller Central Messaging Assistant",
  "version": "1.0.0",
  "description": "AI-powered customer messaging assistant for Amazon Seller Central with quick refund and replacement actions.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://sellercentral.amazon.com/*",
    "https://sellercentral.amazon.co.uk/*",
    "https://sellercentral.amazon.de/*",
    "https://sellercentral.amazon.co.jp/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://sellercentral.amazon.com/messaging/*",
        "https://sellercentral.amazon.com/buyer-messages/*",
        "https://sellercentral.amazon.com/gp/communication-manager/*",
        "https://sellercentral.amazon.co.uk/messaging/*",
        "https://sellercentral.amazon.co.uk/buyer-messages/*",
        "https://sellercentral.amazon.de/messaging/*",
        "https://sellercentral.amazon.de/buyer-messages/*",
        "https://sellercentral.amazon.co.jp/messaging/*",
        "https://sellercentral.amazon.co.jp/buyer-messages/*"
      ],
      "js": ["lib/utils.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
