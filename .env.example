# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sellerdata
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Test Database
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/sellerdata_test

# App
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# A/B Testing
AB_TEST_DEFAULT_CONFIDENCE=0.95
AB_TEST_DEFAULT_MIN_SAMPLE=100
AB_TEST_BAYESIAN_SIMULATIONS=100000

# Content Digest
ANTHROPIC_API_KEY=
TWITTER_BEARER_TOKEN=
FACEBOOK_ACCESS_TOKEN=
DIGEST_MAX_ITEMS=50
DIGEST_IMPORTANCE_THRESHOLD=5.0
